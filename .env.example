# Server
PORT=3001
JWT_SECRET=change-me-in-production
NODE_ENV=development

# App URLs
APP_URL=http://localhost:5173
API_URL=http://localhost:3001

# Database (Postgres — Neon recommended)
# Format: postgresql://user:password@host/db?sslmode=require
DATABASE_URL=

# Cloudflare R2 (S3-compatible object storage for uploads)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=social-scheduler
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev
R2_LOGO_KEY=watermark/logo.png

# Meta (Facebook + Instagram)
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_REDIRECT_URI=http://localhost:3001/api/platforms/facebook/callback

# Google (YouTube)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3001/api/platforms/youtube/callback

# Watermark
WATERMARK_POSITION=southeast
WATERMARK_OPACITY=0.7
WATERMARK_MARGIN=20
WATERMARK_SCALE=0.15
