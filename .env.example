# Server
PORT=3001
JWT_SECRET=change-me-in-production
NODE_ENV=development

# App URLs
APP_URL=http://localhost:5173
API_URL=http://localhost:3001

# Database (Postgres — Neon recommended)
# Format: postgresql://user:password@host/db?sslmode=require
DATABASE_URL=

# Cloudflare R2 (S3-compatible object storage for uploads)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=social-scheduler
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev
R2_LOGO_KEY=watermark/logo.png

# Meta (Facebook + Instagram)
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_REDIRECT_URI=http://localhost:3001/api/platforms/facebook/callback

# Google (YouTube)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3001/api/platforms/youtube/callback

# TikTok Content Posting API (developers.tiktok.com)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:3001/api/video/tiktok/callback

# Watermark
WATERMARK_POSITION=southeast
WATERMARK_OPACITY=0.7
WATERMARK_MARGIN=20
WATERMARK_SCALE=0.15

# Optional: owner-mode TikTok seed
OWNER_TIKTOK_OPEN_ID=
OWNER_TIKTOK_ACCESS_TOKEN=
OWNER_TIKTOK_REFRESH_TOKEN=
OWNER_TIKTOK_DISPLAY_NAME=

# Instagram → YouTube Shorts + TikTok auto-sync (backend-only background job).
# Connect IG, YT and TikTok once via the UI; the cron handles the rest.
# Set IG_AUTOSYNC_ENABLED=true to activate.
IG_AUTOSYNC_ENABLED=false
IG_AUTOSYNC_CRON=0 */6 * * *
IG_AUTOSYNC_LOOKBACK_HOURS=48
IG_AUTOSYNC_SPACING_HOURS=24
IG_AUTOSYNC_MIN_DELAY_MINUTES=60
